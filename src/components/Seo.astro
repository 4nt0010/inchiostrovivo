---
import { SITO } from "../../sito.config.mjs";
import { immagine } from "../lib/immagini.mjs";

interface Props {
  titolo?: string;
  descrizione?: string;
  immagine?: string;
  tipo?: "website" | "article";
  pubblicato?: Date;
  aggiornato?: Date;
  noindex?: boolean;
  jsonld?: object | object[];
}
const p = Astro.props;
const titoloPagina = p.titolo ? `${p.titolo} | ${SITO.nome}` : `${SITO.nome}: il blog degli studenti del ${SITO.scuola} di ${SITO.citta}`;
const grezza = (p.descrizione || SITO.descrizione).replace(/\s+/g, " ").trim();
const descrizione = grezza.length <= 160 ? grezza : grezza.slice(0, 159).replace(/\s+\S*$/, "") + "…";
const canonical = new URL(Astro.url.pathname, SITO.url).href;
const img = p.immagine ? new URL(immagine(p.immagine, 1600), SITO.url).href : new URL("/anteprima-social.png", SITO.url).href;
const ld = p.jsonld ? (Array.isArray(p.jsonld) ? p.jsonld : [p.jsonld]) : [];
---
<title>{titoloPagina}</title>
<meta name="description" content={descrizione} />
<link rel="canonical" href={canonical} />
{p.noindex && <meta name="robots" content="noindex" />}
<meta property="og:site_name" content={SITO.nome} />
<meta property="og:locale" content="it_IT" />
<meta property="og:type" content={p.tipo ?? "website"} />
<meta property="og:title" content={p.titolo ?? SITO.nome} />
<meta property="og:description" content={descrizione} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={img} />
<meta name="twitter:card" content="summary_large_image" />
{p.pubblicato && <meta property="article:published_time" content={p.pubblicato.toISOString()} />}
{p.aggiornato && <meta property="article:modified_time" content={p.aggiornato.toISOString()} />}
{ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
