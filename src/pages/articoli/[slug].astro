---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Elenco from "../../components/Elenco.astro";
import { SITO } from "../../../sito.config.mjs";
import { immagine, srcset } from "../../lib/immagini.mjs";
import { articoli, mappaRubriche, data, estratto, minutiLettura, slugify, type Articolo } from "../../lib/contenuti";

export async function getStaticPaths() {
  const tutti = await articoli();
  return tutti.map((a) => ({ params: { slug: a.id }, props: { articolo: a, tutti } }));
}

const { articolo: a, tutti } = Astro.props as { articolo: Articolo; tutti: Articolo[] };
const { Content } = await render(a);
const mappa = await mappaRubriche();
const rub = a.data.rubriche.map((r) => mappa.get(r)).filter((r) => !!r);
const descrizione = estratto(a);
const url = `${SITO.url}/articoli/${a.id}/`;

// Articoli correlati: stessa rubrica, poi i più recenti
const correlati = tutti
  .filter((x) => x.id !== a.id)
  .map((x) => ({ x, punti: x.data.rubriche.filter((r) => a.data.rubriche.includes(r)).length }))
  .sort((p, q) => q.punti - p.punti || q.x.data.date.getTime() - p.x.data.date.getTime())
  .slice(0, 3)
  .map((p) => p.x);

const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    mainEntityOfPage: { "@type": "WebPage", "@id": url },
    headline: a.data.title,
    description: descrizione,
    image: a.data.copertina ? [new URL(immagine(a.data.copertina, 1600), SITO.url).href] : undefined,
    datePublished: a.data.date.toISOString(),
    dateModified: (a.data.aggiornato ?? a.data.date).toISOString(),
    inLanguage: "it-IT",
    articleSection: rub.map((r) => r!.data.nome),
    author: a.data.autori.map((n) => ({
      "@type": n === "Redazione" ? "Organization" : "Person",
      name: n,
      url: `${SITO.url}/autori/${slugify(n)}/`,
    })),
    publisher: {
      "@type": "NewsMediaOrganization",
      "@id": `${SITO.url}/#redazione`,
      name: SITO.nome,
      url: `${SITO.url}/`,
      logo: { "@type": "ImageObject", url: `${SITO.url}/logo.png` },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITO.url}/` },
      { "@type": "ListItem", position: 2, name: "Articoli", item: `${SITO.url}/articoli/` },
      ...(rub[0] ? [{ "@type": "ListItem", position: 3, name: rub[0]!.data.nome, item: `${SITO.url}/rubriche/${rub[0]!.id}/` }] : []),
      { "@type": "ListItem", position: rub[0] ? 4 : 3, name: a.data.title, item: url },
    ],
  },
];
---
<Base
  titolo={a.data.title}
  descrizione={descrizione}
  immagine={a.data.copertina}
  tipo="article"
  pubblicato={a.data.date}
  aggiornato={a.data.aggiornato}
  jsonld={jsonld}
  sfondo={a.data.copertina ? immagine(a.data.copertina, 400) : undefined}
  lettura
>
  <article data-pagefind-body data-pagefind-meta={a.data.copertina ? `image:${immagine(a.data.copertina, 400)}` : undefined}>
    <header class="art-testa">
      <a class="indietro" href="/articoli/" data-pagefind-ignore>
        <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14"><path d="M12 12 4 4m0 0v6m0-6h6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Tutti gli articoli
      </a>
      <div>
        <h1 style={`view-transition-name: t-${a.id}`}>{a.data.title}</h1>
        {a.data.descrizione && <p class="art-occhiello">{a.data.descrizione}</p>}
        <dl class="art-meta" data-pagefind-ignore>
          <div>
            <span class="firma-iniziale" aria-hidden="true">{(a.data.autori[0] ?? "R").charAt(0).toUpperCase()}</span>
            <dt class="nascosto">Autori</dt>
            <dd>{a.data.autori.map((n, i) => (
              <>{i > 0 && (i === a.data.autori.length - 1 ? " e " : ", ")}<a href={`/autori/${slugify(n)}/`}>{n}</a></>
            ))}</dd>
          </div>
          {rub[0] && (
            <div><dt>Rubrica</dt><dd><a href={`/rubriche/${rub[0]!.id}/`}>{rub[0]!.data.nome}</a></dd></div>
          )}
          <div><dt>Data</dt><dd><time datetime={a.data.date.toISOString()}>{data(a.data.date)}</time></dd></div>
          <div><dd>lettura {minutiLettura(a)} min</dd></div>
        </dl>
      </div>
    </header>
    <div class="art-linea"><hr /></div>

    {a.data.copertina && (
      <figure class="articolo-copertina">
        <img
          src={immagine(a.data.copertina, 1600)}
          srcset={srcset(a.data.copertina)}
          sizes="(min-width: 64rem) 61rem, 100vw"
          alt={a.data.alt_copertina}
          fetchpriority="high"
          decoding="async"
          style={`view-transition-name: c-${a.id}`}
        />
      </figure>
    )}

    <div class="testo">
      <Content />
    </div>

    <footer class="articolo-piede" data-pagefind-ignore>
      {rub.length > 0 && (
        <ul class="articolo-rubriche" aria-label="Rubriche">
          {rub.map((r) => <li><a href={`/rubriche/${r!.id}/`}>{r!.data.nome}</a></li>)}
        </ul>
      )}
      <div class="condividi">
        <span>Condividi</span>
        <a href={`https://wa.me/?text=${encodeURIComponent(a.data.title + " " + url)}`} aria-label="Condividi su WhatsApp" rel="noopener" target="_blank">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
        </a>
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} aria-label="Condividi su Facebook" rel="noopener" target="_blank">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7.5H16l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4a21 21 0 0 0-2.3-.1c-2.3 0-3.8 1.4-3.8 3.9v2.3H8v3h2.5V21h3Z"/></svg>
        </a>
        <a href={`https://x.com/intent/post?url=${encodeURIComponent(url)}&text=${encodeURIComponent(a.data.title)}`} aria-label="Condividi su X" rel="noopener" target="_blank">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M17.8 3h3l-6.6 7.6L22 21h-6.1l-4.8-6.2L5.6 21h-3l7.1-8.1L2.2 3h6.2l4.3 5.7L17.8 3Zm-1 16.2h1.7L7.3 4.7H5.5l11.3 14.5Z"/></svg>
        </a>
        <button type="button" class="copia-link" data-url={url} aria-label="Copia il link">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg>
        </button>
      </div>
    </footer>
  </article>

  <section class="sezione" aria-labelledby="correlati">
    <div class="contenitore">
      <h2 id="correlati" class="sezione-titolo tratto">Da leggere dopo</h2>
      <Elenco articoli={correlati} livello="h3" />
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLAnchorElement>(".video-anteprima").forEach((a) => {
      a.addEventListener("click", (e) => {
        e.preventDefault();
        const f = document.createElement("iframe");
        f.src = `https://www.youtube-nocookie.com/embed/${a.dataset.yt}?autoplay=1`;
        f.title = "Video YouTube";
        f.allow = "accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture";
        f.allowFullscreen = true;
        a.replaceWith(f);
      });
    });
    document.querySelectorAll<HTMLButtonElement>(".copia-link").forEach((b) => {
      b.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(b.dataset.url || location.href);
          b.setAttribute("aria-label", "Link copiato");
          b.title = "Link copiato";
        } catch {}
      });
    });
  </script>
</Base>
